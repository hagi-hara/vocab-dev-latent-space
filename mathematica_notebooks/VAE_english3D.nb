Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Roy", " ", "et", " ", 
     RowBox[{"al", ".", 
      RowBox[{"\:ff08", "2015", "\:ff09"}]}], 
     "\:306e\:5404\:8a9e\:306e\:521d\:51fa\:6708\:9f62aoa_M\:304b\:3089"}], "\:ff0c", 
    RowBox[{
     RowBox[{"10", "\:ff5e25\:304b\:6708\:306e\:7d2f\:7a4d\:4e8c\:5024CDI"}], 
     "-", 
     RowBox[{"like", " ", "profiles\:3092\:4f5c\:6210\:3057"}]}], "\:ff0c", 
    "VAE\:6f5c\:5728\:7a7a\:9593\:3078\:6295\:5f71\:3059\:308b", "\:ff0e", 
    RowBox[{
     RowBox[{"Construct", " ", "cumulative", " ", "binary", " ", "CDI"}], "-", 
     RowBox[{
     "like", " ", "profiles", " ", "from", " ", "10", " ", "to", " ", "25", " ",
       "months", " ", "using", " ", "each", " ", 
      RowBox[{"word", "'"}], "s", " ", "first"}], "-", 
     RowBox[{"production", " ", "age", " ", 
      RowBox[{"(", "aoa_M", ")"}], " ", "from", " ", "Roy", " ", "et", " ", 
      RowBox[{"al", ".", 
       RowBox[{"(", "2015", ")"}]}]}]}], ",", 
    RowBox[{
    "and", " ", "project", " ", "them", " ", "into", " ", "the", " ", "VAE", " ",
      "latent", " ", 
     RowBox[{"space", "."}]}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Roy", " ", 
    RowBox[{"child", ":", 
     RowBox[{
     "age", " ", "of", " ", "first", " ", "production", " ", "for", " ", 
      "the", " ", "680", " ", "CDI", " ", "items"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"debRoyAoAM", "=", 
     RowBox[{"debRoy3D", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"3", ";;"}], ",", "9"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"debRoyAgeM", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"10", ",", "25"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
