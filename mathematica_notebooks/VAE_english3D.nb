Cell[BoxData[
 RowBox[{
  RowBox[{"whichvec", "[", 
   RowBox[{"vec_", ",", "ref_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"work", ",", "work2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"work", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"ref", ".", "#"}], ")"}], "&"}], "/@", "vec"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"work2", "=", 
      RowBox[{"Sort", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"Length", "[", "work", "]"}], "]"}], ",", "work"}], "}"}],
          "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"#1", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}], ">", 
          RowBox[{"Abs", "[", 
           RowBox[{"#2", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "&"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"work2", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
       RowBox[{"Sign", "[", 
        RowBox[{"work2", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}]}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
