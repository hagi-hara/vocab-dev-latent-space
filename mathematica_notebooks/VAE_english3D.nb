4259ccf30219"],

Cell[BoxData[
 RowBox[{
  RowBox[{"grid", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"revm", ".", 
      RowBox[{"{", 
       RowBox[{"i", ",", "j", ",", "k"}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"-", "4"}], ",", "4", ",", 
       RowBox[{
        RowBox[{"8", "/", "29"}], "//", "N"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "4", ",", 
       RowBox[{"-", "4"}], ",", 
