Cell["\<\
5\:672c\:306e\:767a\:9054\:8ecc\:9053\:306b\:6cbf\:3063\:305f\:5408\:6210CDI\
\:30d7\:30ed\:30d5\:30a1\:30a4\:30eb\:306e\:751f\:6210
Generation of synthetic CDI profiles along the five developmental trajectories\
\>", "Subsubsection",
 CellChangeTimes->{{3.9199077260513563`*^9, 3.919907770099908*^9}, 
   4.0022579123122616`*^9},ExpressionUUID->"41a36df0-7461-0743-ba1d-\
9620e338b25e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "\:8ecc\:9053\:3068ptot\:6c34\:6e96\:3054\:3068\:306b\:518d\:73fe\:53ef\
\:80fd\:306a\:4e71\:6570seed\:3092\:5b9a\:3081\:308b", "\:ff0e", 
    "\[IndentingNewLine]", 
    RowBox[{
    "Define", " ", "reproducible", " ", "random", " ", "seeds", " ", "for", " ",
      "each", " ", "trajectory", " ", "and", " ", "ptot", " ", 
     RowBox[{"level", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"seedIn", "[", "k_", "]"}], ":=", 
    RowBox[{"Hash", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<in\>\"", ",", "k"}], "}"}], ",", "\"\<SHA256\>\""}], 
     "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"seedOut", "[", "k_", "]"}], ":=", 
    RowBox[{"Hash", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<out\>\"", ",", "k"}], "}"}], ",", "\"\<SHA256\>\""}], 
     "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"seedLeft", "[", "k_", "]"}], ":=", 
    RowBox[{"Hash", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<Left\>\"", ",", "k"}], "}"}], ",", "\"\<SHA256\>\""}], 
     "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"seedRight", "[", "k_", "]"}], ":=", 
    RowBox[{"Hash", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<right\>\"", ",", "k"}], "}"}], ",", "\"\<SHA256\>\""}], 
     "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"seedCenter", "[", "k_", "]"}], ":=", 
    RowBox[{"Hash", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<center\>\"", ",", "k"}], "}"}], ",", "\"\<SHA256\>\""}], 
     "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.9750326014726887`*^9, 3.9750326014726887`*^9}, {
