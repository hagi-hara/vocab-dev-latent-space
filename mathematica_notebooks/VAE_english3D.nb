Cell[CellGroupData[{

Cell["\<\
\:4e2d\:592e\:8ecc\:9053\:4e0a\:306e\:7dcf\:8a9e\:5f59\:5272\:54080.5\:306b\
\:304a\:3051\:308b\:8a9e\:3054\:3068\:306e\:8868\:51fa\:78ba\:7387
Word-wise production probabilities on the center trajectory at ptot = 0.5

center (green)   ptot = 0.5\
\>", "Subsubsection",
 CellChangeTimes->{{4.002546733568821*^9, 4.0025467416091766`*^9}, {
  4.002618212320263*^9, 4.0026182144144974`*^9}, {4.0026244896168995`*^9, 
  4.002624493091364*^9}},ExpressionUUID->"b72ed771-2174-2342-b67d-\
7cb7d26f7f40"],

Cell[TextData[StyleBox["\:4ee5\:4e0b\:306e\:56f3\:3067\:306f\:ff0c22\:30ab\
\:30c6\:30b4\:30ea\:30fc\:3092\:9806\:306b\:9023\:7d50\:3057\:ff0c\:5404\:30ab\
\:30c6\:30b4\:30ea\:30fc\:5185\:306e\:8a9e\:3092 VoA \:306e\:5c0f\:3055\:3044\
\:9806\:306b\:4e26\:3079\:308b\:ff0e\:3053\:3053\:3067\:306e VoA \:306f\:ff0c\
\:4e2d\:592e\:767a\:9054\:8ecc\:9053\:4e0a\:3067\:8a9e\:306e\:4e88\:6e2c\:8868\
\:51fa\:78ba\:7387\:304c0.5\:306b\:9054\:3059\:308b\:7dcf\:8a9e\:5f59\:5272\
\:5408\:3067\:3042\:308a\:ff0c\:5024\:304c\:5c0f\:3055\:3044\:307b\:3069\:65e9\
\:3044\:7372\:5f97\:6bb5\:968e\:306b\:5bfe\:5fdc\:3059\:308b\:ff0e  \n\nIn \
the plots below, the 22 categories are concatenated, and words within each \
category are ordered by increasing VoA. Here VoA is the total vocabulary \
proportion at which a word\[CloseCurlyQuote]s predicted production \
probability reaches 0.5 along the center developmental trajectory; smaller \
values correspond to earlier acquisition stages.",
 FontColor->RGBColor[0., 0.5019607843137255, 1.]]], "Text",
 CellChangeTimes->{
  4.002626407677822*^9},ExpressionUUID->"19dcef0b-b9b7-8f40-b9c0-\
3acd90daacd3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "\:30ab\:30c6\:30b4\:30ea\:30fc\:5185\:3067VoA\:9806\:306b\:4e26\:3079\
\:305f\:5404\:8a9e\:306e\:63a8\:5b9a\:8868\:51fa\:78ba\:7387", "\:ff0e", 
    "\[IndentingNewLine]", 
    RowBox[{
    "Predicted", " ", "production", " ", "probabilities", " ", "ordered", " ",
      "by", " ", "VoA", " ", "within", " ", "each", " ", 
     RowBox[{"category", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"plotPtot", "=", "0.5"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"orderedProbabilities", "=", 
     RowBox[{
      RowBox[{"predict", "[", 
       RowBox[{"zcenter3", "[", "plotPtot", "]"}], "]"}], "[", 
      RowBox[{"[", "orderbyvoa", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{
    RowBox[{"orderedPoints", "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Tooltip", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#1", ",", "#2"}], "}"}], ",", 
          RowBox[{"fitem3", "[", "#3", "]"}]}], "]"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", "orderedProbabilities", "]"}], "]"}], ",", 
         "orderedProbabilities", ",", "orderbyvoa"}], "}"}]}], "]"}]}], ";"}],
    "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"centerWordProbabilityPlot", "=", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"orderedPoints", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ";;", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "&"}], "/@", 
         "catn"}], ")"}], ",", 
       RowBox[{"Filling", "->", "Axis"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Word rank (VoA order within category)\>\"", 
          ",", "\"\<Predicted production probability\>\""}], "}"}]}], ",", 
       RowBox[{"ImageSize", "->", "600"}], ",", 
       RowBox[{"AspectRatio", "->", 
        RowBox[{"1", "/", "4"}]}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1.1"}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{"catname", ",", "Right"}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "centerWordProbabilityPlot"}]}]], "Input",
 CellChangeTimes->{{4.0025464495204735`*^9, 4.0025464495204735`*^9}, 
