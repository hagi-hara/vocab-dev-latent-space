Cell[BoxData[
 RowBox[{
  RowBox[{"predict", "[", "z_", "]"}], ":=", 
  RowBox[{"LogisticSigmoid", "[", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"relu", "[", "#", "]"}], "&"}], "/@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"revm", ".", "z"}], ")"}], ".", "wdd1E"}], ")"}], "+", 
          "wdd1bE"}], ")"}]}], ")"}], ".", "wdd2E"}], "+", "wdd2bE"}], ")"}], 
   "]"}]}]], "Input",
 CellLabel->"In[55]:=",ExpressionUUID->"51699af8-40f3-4562-a055-cbcc5a9ef2f5"]
}, Open  ]],

