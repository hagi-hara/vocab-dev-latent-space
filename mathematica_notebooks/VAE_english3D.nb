mpfunc\:3092\:4f5c\:308a"}], "\:ff0c", 
   RowBox[{
   "\:305d\:306e0", ".5", 
    "\:7b49\:5024\:9762cmp05\:3092CSV\:7531\:6765\:306ecmp05Grid\:3068\:91cd\
\:306d\:3066\:5f62\:72b6\:3092\:6bd4\:8f03\:3059\:308b"}], "\:ff0e", 
   RowBox[{
    RowBox[{
    "Direct", " ", "evaluation", " ", "of", " ", "predict", " ", "on", " ", 
     "a", " ", "dense", " ", "grid", " ", "is", " ", "time"}], "-", 
    RowBox[{
     RowBox[{"consuming", ".", "The"}], " ", "main", " ", "isosurface", " ", 
     "therefore", " ", "uses", " ", "decoder", " ", "outputs", " ", 
     "precomputed", " ", "in", " ", 
     RowBox[{"Colab", ".", "Here"}]}]}], ",", 
   RowBox[{
   "mpfunc", " ", "is", " ", "constructed", " ", "from", " ", "direct", " ", 
    "predictions", " ", "on", " ", "a", " ", "coarse", " ", "9", "\[Times]", 
    "9", "\[Times]", "9", " ", "grid"}], ",", 
   RowBox[{
    RowBox[{"and", " ", "its", " ", "0.5", " ", "isosurface", " ", 
     RowBox[{"(", "cmp05", ")"}], " ", "is", " ", "overlaid", " ", "with", " ",
      "the", " ", "CSV"}], "-", 
    RowBox[{"based", " ", "isosurface", " ", 
     RowBox[{"(", "cmp05Grid", ")"}], " ", "for", " ", "a", " ", "visual", " ", 
     RowBox[{"comparison", "."}]}]}]}], "*)"}]], "Input",
