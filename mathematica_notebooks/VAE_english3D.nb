Cell[CellGroupData[{

Cell["\<\
\:8ecc\:9053\:5468\:8fba\:306e\:5c40\:6240\:4e8b\:5f8c\:6a19\:6e96\:504f\:5dee\
\:3068\:6f5c\:5728\:70b9\:751f\:6210
Local posterior standard deviations and latent-point generation around \
trajectories\
\>", "Subsection",
 CellChangeTimes->{
  4.0022003440536823`*^9},ExpressionUUID->"c108b11f-61e3-3248-818d-\
7627bdec8331"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "\:6f5c\:5728\:70b9z\:306b\:6700\:3082\:8fd1\:30443\:3064\:306e\:89b3\:6e2c\
CDI\:30d7\:30ed\:30d5\:30a1\:30a4\:30eb\:3092\:9078\:3073", "\:ff0c", 
    "Encoder\:306e\:4e8b\:5f8c\:6a19\:6e96\:504f\:5dee\:3092\:6f5c\:5728\:6b21\
\:5143\:3054\:3068\:306b\:5e73\:5747\:3059\:308b", "\:ff0e", 
    "\:3053\:3053\:3067\:5e73\:5747\:3059\:308b\:306e\:306f\:5206\:6563\:3067\
\:306f\:306a\:304f\:6a19\:6e96\:504f\:5dee\:3067\:3042\:308b", "\:ff0e", 
    "\[IndentingNewLine]", 
    RowBox[{
    "The", " ", "three", " ", "observed", " ", "CDI", " ", "profiles", " ", 
     "nearest", " ", "to", " ", "latent", " ", "point", " ", "z", " ", "are", 
     " ", "selected"}], "\:ff0c", 
    RowBox[{
    "and", " ", "their", " ", "encoder", " ", "posterior", " ", "standard", " ",
      "deviations", " ", "are", " ", "averaged", " ", "separately", " ", 
     "for", " ", "each", " ", "latent", " ", "dimension"}], "\:ff0e", 
    RowBox[{
    "The", " ", "averaged", " ", "quantities", " ", "are", " ", "standard", " ",
      "deviations"}], "\:ff0c", 
    RowBox[{"not", " ", "variances"}], "\:ff0e"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"nNearestProfiles", "=", "3"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"nearestProfileIndices", "[", "z_", "]"}], ":=", 
     RowBox[{"TakeSmallestBy", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"Length", "[", "zdataEsort", "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"Norm", "[", 
         RowBox[{"z", "-", 
          RowBox[{"zdataEsort", "[", 
           RowBox[{"[", "#", "]"}], "]"}]}], "]"}], "&"}], ",", 
       "nNearestProfiles"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"z2\[Sigma]", "[", "z_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"nearestIndices", ",", "nearestProfiles"}], "}"}], ",", 
       RowBox[{
        RowBox[{"nearestIndices", "=", 
         RowBox[{"nearestProfileIndices", "[", "z", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"nearestProfiles", "=", 
         RowBox[{"alldatasort", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"nearestIndices", "+", "1"}], ",", 
            RowBox[{"5", ";;"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Mean", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{"0.5", "*", 
             RowBox[{"tologsigma", "[", "#", "]"}]}], "]"}], "&"}], "/@", 
          "nearestProfiles"}], "]"}]}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.0021999034161015`*^9, 4.0021999144227943`*^9}},
 CellLabel->
  "In[319]:=",ExpressionUUID->"78ce518b-e8a9-0545-82a4-54c7f82a2508"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"\:8ecc\:9053\:4e0a\:306e\:70b9zc\:3092\:5e73\:5747\:3068\:3057", "\:ff0c", 
    RowBox[{
    "\:5c40\:6240\:7684\:306b\:63a8\:5b9a\:3057\:305f\:4e8b\:5f8c\:6a19\:6e96\
\:504f\:5dee\:304b\:3089", " ", 
     "\:5bfe\:89d2\:5171\:5206\:6563\:884c\:5217\:3092\:4f5c\:308a"}], "\:ff0c",
     "num\:500b\:306e\:6f5c\:5728\:70b9\:3092\:518d\:73fe\:53ef\:80fd\:306a\
\:5f62\:3067\:751f\:6210\:3059\:308b", "\:ff0e", 
    RowBox[{
     RowBox[{"Generate", " ", "num", " ", "reproducible", " ", "latent"}], "-", 
     RowBox[{
     "space", " ", "points", " ", "around", " ", "trajectory", " ", "point", " ",
       "zc"}]}], "\:ff0c", 
    RowBox[{
    "using", " ", "a", " ", "diagonal", " ", "covariance", " ", "matrix", " ",
      "constructed", " ", "from", " ", "the", " ", "locally", " ", 
     "estimated", " ", "posterior", " ", "standard", " ", "deviations"}], "\:ff0e",
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
    "nNearestProfiles\:306f\:5c40\:6240\:6a19\:6e96\:504f\:5dee\:306e\:63a8\
\:5b9a\:306b\:4f7f\:3046\:8fd1\:508d\:30d7\:30ed\:30d5\:30a1\:30a4\:30eb\:6570\
\:3067\:3042\:308a", "\:ff0c", 
    "num\:306f\:751f\:6210\:3059\:308b\:6f5c\:5728\:70b9\:306e\:6570\:3067\
\:3042\:308b", "\:ff0e", 
    RowBox[{
    "nNearestProfiles", " ", "is", " ", "the", " ", "number", " ", "of", " ", 
     "neighboring", " ", "profiles", " ", "used", " ", "to", " ", "estimate", 
     " ", "local", " ", "standard", " ", "deviations"}], "\:ff0c", 
    RowBox[{
    "whereas", " ", "num", " ", "is", " ", "the", " ", "number", " ", "of", " ",
      "generated", " ", "points"}], "\:ff0e"}], "*)"}], "\[IndentingNewLine]",
   "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"generate", "[", 
     RowBox[{"zc_", ",", "num_Integer", ",", "seed_Integer"}], "]"}], ":=", 
    RowBox[{"BlockRandom", "[", 
     RowBox[{
      RowBox[{"SeedRandom", "[", 
       RowBox[{"seed", ",", 
        RowBox[{"Method", "->", "\"\<MersenneTwister\>\""}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"RandomVariate", "[", 
       RowBox[{
        RowBox[{"MultinormalDistribution", "[", 
         RowBox[{"zc", ",", 
          RowBox[{"DiagonalMatrix", "[", 
           RowBox[{
            RowBox[{"z2\[Sigma]", "[", "zc", "]"}], "^", "2"}], "]"}]}], 
         "]"}], ",", "num"}], "]"}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{4.0022001152082157`*^9, 4.002200145173092*^9}, {
