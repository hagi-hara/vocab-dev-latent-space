Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "\:5404\:8ecc\:9053\:4f4d\:7f6e\:306e\:5468\:56f2\:306b\:751f\:6210\:3057\
\:305f", "\:ff0c", 
    "\:5f15\:304d\:623b\:3057\:524d\:306e\:30b5\:30f3\:30d7\:30eb\:306b\:3064\
\:3044\:3066\:7dcf\:8a9e\:5f59\:6570\:306e\:7d71\:8a08\:91cf\:3092\:8a08\:7b97\
\:3059\:308b", "\:ff0e", 
    RowBox[{
     RowBox[{"Calculate", " ", "total"}], "-", 
     RowBox[{
     "vocabulary", " ", "statistics", " ", "for", " ", "samples", " ", 
      "generated", " ", "around", " ", "each", " ", "trajectory", " ", 
      "position", " ", "before", " ", 
      RowBox[{"projection", "."}]}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "rawSampleVocabularyStats", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "rawSampleVocabularyStats", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<Ptot\>\"", "->", "0.5"}], ",", 
       RowBox[{"\"\<NSamples\>\"", "->", "100"}], ",", 
       RowBox[{"\"\<Seed\>\"", "->", "9999"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"rawSampleVocabularyStats", "[", 
     RowBox[{"trajectoryFunction_", ",", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ptot", "=", 
         RowBox[{"OptionValue", "[", "\"\<Ptot\>\"", "]"}]}], ",", 
        RowBox[{"nSamples", "=", 
         RowBox[{"OptionValue", "[", "\"\<NSamples\>\"", "]"}]}], ",", 
        RowBox[{"seed", "=", 
         RowBox[{"OptionValue", "[", "\"\<Seed\>\"", "]"}]}], ",", 
        "latentCenter", ",", "generatedSamples", ",", "vocabularyTotals", ",",
         "targetVocabulary", ",", "meanVocabulary", ",", 
        "absoluteDeviations"}], "}"}], ",", 
      RowBox[{
       RowBox[{"latentCenter", "=", 
        RowBox[{"trajectoryFunction", "[", "ptot", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"generatedSamples", "=", 
        RowBox[{"generate", "[", 
         RowBox[{"latentCenter", ",", "nSamples", ",", "seed"}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"vocabularyTotals", "=", 
        RowBox[{"Total", "/@", 
         RowBox[{"(", 
          RowBox[{"predict", "/@", "generatedSamples"}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"targetVocabulary", "=", 
        RowBox[{"Total", "[", 
         RowBox[{"predict", "[", "latentCenter", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"meanVocabulary", "=", 
        RowBox[{"Mean", "[", "vocabularyTotals", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"absoluteDeviations", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{"vocabularyTotals", "-", "targetVocabulary"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<CenterVocabulary\>\"", "->", "targetVocabulary"}], ",", 
         RowBox[{"\"\<Mean\>\"", "->", "meanVocabulary"}], ",", 
         RowBox[{"\"\<SD\>\"", "->", 
          RowBox[{"StandardDeviation", "[", "vocabularyTotals", "]"}]}], ",", 
         RowBox[{"\"\<Max\>\"", "->", 
          RowBox[{"Max", "[", "vocabularyTotals", "]"}]}], ",", 
         RowBox[{"\"\<Min\>\"", "->", 
          RowBox[{"Min", "[", "vocabularyTotals", "]"}]}], ",", 
         RowBox[{"\"\<MaxMinusMean\>\"", "->", 
          RowBox[{
           RowBox[{"Max", "[", "vocabularyTotals", "]"}], "-", 
           "meanVocabulary"}]}], ",", 
         RowBox[{"\"\<MinMinusMean\>\"", "->", 
          RowBox[{
           RowBox[{"Min", "[", "vocabularyTotals", "]"}], "-", 
           "meanVocabulary"}]}], ",", 
         RowBox[{"\"\<MaxRelativeDeviation\>\"", "->", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Max", "[", "vocabularyTotals", "]"}], "-", 
             "meanVocabulary"}], ")"}], "/", "meanVocabulary"}]}], ",", 
         RowBox[{"\"\<MinRelativeDeviation\>\"", "->", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Min", "[", "vocabularyTotals", "]"}], "-", 
             "meanVocabulary"}], ")"}], "/", "meanVocabulary"}]}], ",", 
         RowBox[{"\"\<MeanAbsoluteDeviationFromTarget\>\"", "->", 
          RowBox[{"Mean", "[", "absoluteDeviations", "]"}]}], ",", 
         RowBox[{"\"\<SDAbsoluteDeviationFromTarget\>\"", "->", 
          RowBox[{"StandardDeviation", "[", "absoluteDeviations", "]"}]}]}], 
        "|>"}]}]}], "]"}]}]}]}]], "Input",
