Cell[BoxData[
 RowBox[{
  RowBox[{"meanfiltervec", "[", 
   RowBox[{"vec_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"d", ",", "work", ",", "k"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"d", " ", "=", " ", 
      RowBox[{"Length", "[", 
       RowBox[{"Transpose", "[", "vec", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
