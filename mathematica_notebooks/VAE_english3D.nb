         RowBox[{"predict", "[", 
          RowBox[{"trajectory", "[", "plotPtot", "]"}], "]"}], "[", 
         RowBox[{"[", "orderbyvoa", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"points", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Tooltip", "[", 
            RowBox[{
             RowBox[{"{", 
