     "probability", " ", "differences", " ", "at", " ", "a", " ", "specified",
       " ", "total", " ", "vocabulary", " ", 
      RowBox[{"proportion", "."}]}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "leftRightDifferencePlotAt", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"leftRightDifferencePlotAt", "[", 
      RowBox[{"ptot_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"values", ",", "points", ",", 
         RowBox[{"yRange", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "0.9"}], ",", "0.9"}], "}"}]}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"values", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"predict", "[", 
             RowBox[{"zleft3", "[", "ptot", "]"}], "]"}], "-", 
            RowBox[{"predict", "[", 
             RowBox[{"zright3", "[", "ptot", "]"}], "]"}]}], ")"}], "[", 
          RowBox[{"[", "orderbyvoa", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"points", "=", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Tooltip", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"#1", ",", "#2"}], "}"}], ",", 
              RowBox[{"fitem3", "[", "#3", "]"}]}], "]"}], "&"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"Length", "[", "values", "]"}], "]"}], ",", "values", ",",
              "orderbyvoa"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ListPlot", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"points", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ";;", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "&"}], "/@", 
            "catn"}], ")"}], ",", 
          RowBox[{"Filling", "->", "Axis"}], ",", 
          RowBox[{"Frame", "->", "True"}], ",", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Word position (categories concatenated; VoA order \
within each)\>\"", ",", "\"\<Production probability (Left - Right)\>\""}], 
            "}"}]}], ",", 
          RowBox[{"ImageSize", "->", "600"}], ",", 
          RowBox[{"AspectRatio", "->", 
           RowBox[{"1", "/", "2"}]}], ",", 
          RowBox[{"PlotRange", "->", "yRange"}], ",", 
          RowBox[{"PlotLegends", "->", 
           RowBox[{"Placed", "[", 
            RowBox[{"catname", ",", "Right"}], "]"}]}], ",", 
          RowBox[{"PlotLabel", "->", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<ptot = \>\"", ",", "ptot"}], "}"}], "]"}]}], ",", 
          RowBox[{"Epilog", "->", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"Dashed", ",", "Thin", ",", 
               RowBox[{"Line", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"ptotToRank", "[", "nc", "]"}], "[", "ptot", 
                    "]"}], ",", 
                    RowBox[{"yRange", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"ptotToRank", "[", "nc", "]"}], "[", "ptot", 
                    "]"}], ",", 
                    RowBox[{"yRange", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "}"}], "]"}]}],
               "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"nc", ",", 
               RowBox[{"Length", "[", "catn", "]"}]}], "}"}]}], "]"}]}]}], 
         "]"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"leftRightDifferencePlotAt", "[", "0.5", "]"}], 
    "*)"}]}]}]], "Input",
