Cell[BoxData[
 RowBox[{
  RowBox[{"meanfiltervecandend", "[", 
   RowBox[{"vec_", ",", "n_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "d", ",", "work", ",", "work2", ",", "trw", ",", "trw2", ",", "k"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"d", " ", "=", " ", 
      RowBox[{"Length", "[", 
       RowBox[{"Transpose", "[", "vec", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"work2", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"MeanFilter", "[", 
         RowBox[{
          RowBox[{"vec", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "k"}], "]"}], "]"}], ",", "2"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", "d"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"work", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"MeanFilter", "[", 
         RowBox[{
          RowBox[{"vec", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "k"}], "]"}], "]"}], ",", "n"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", "d"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"trw2", "=", " ", 
      RowBox[{"Transpose", "[", "work2", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"trw", "=", 
      RowBox[{"Transpose", "[", "work", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"trw2", "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", "m"}], "]"}], "]"}], ",", "trw", ",", 
