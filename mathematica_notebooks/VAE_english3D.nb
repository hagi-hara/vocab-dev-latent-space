 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "\:4efb\:610f\:306e\:7dcf\:8a9e\:5f59\:5272\:5408\:3067", " ", 
     "Left\:ff0dRight", " ", 
     "\:306e\:8a9e\:3054\:3068\:306e\:8868\:51fa\:78ba\:7387\:5dee\:3092\:63cf\
\:304f"}], "\:ff0e", 
    RowBox[{
     RowBox[{"Plot", " ", "word"}], "-", 
     RowBox[{"wise", " ", "Left\:ff0dRight", " ", "production"}], "-", 
