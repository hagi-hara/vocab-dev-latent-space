\:306e\:4ea4\:70b9\:3092\:6c42\:3081\:308b", "\:ff0e", 
   RowBox[{
    RowBox[{
    "Move", " ", "along", " ", "the", " ", "line", " ", "defined", " ", "by", 
     " ", "the", " ", "gradient", " ", "of", " ", "total", " ", "vocabulary", 
     " ", "proportion", " ", "at", " ", "the", " ", "starting", " ", "point", 
     " ", "and", " ", "find", " ", "its", " ", "intersection", " ", "with", " ",
      "the", " ", "specified", " ", "equal"}], "-", "total", "-", 
    "vocabulary", "-", 
    RowBox[{"proportion", " ", 
