Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"1", "\:672c\:306e\:8ecc\:9053\:306b\:3064\:3044\:3066"}], "\:ff0c", 
    RowBox[{"ptot", "=", 
     RowBox[{"0.1", "\:304b\:30890", ".9", "\:307e\:3067"}]}], "\:ff0c", 
    "\:5404\:6c34\:6e96\:3067\:7dcf\:8a9e\:5f59\:5272\:5408\:4e00\:5b9a\:9762\
\:4e0a\:306e\:6f5c\:5728\:70b9\:3092\:751f\:6210\:3057", "\:ff0c", 
    "decoder\:3067\:5408\:6210CDI\:30d7\:30ed\:30d5\:30a1\:30a4\:30eb\:3078\
\:5909\:63db\:3059\:308b", "\:ff0e", 
    RowBox[{"For", " ", "one", " ", "trajectory"}], ",", 
    RowBox[{
     RowBox[{
     "generate", " ", "latent", " ", "points", " ", "on", " ", "the", " ", 
      "corresponding", " ", "constant"}], "-", "total", "-", "vocabulary", "-", 
     RowBox[{
     "proportion", " ", "surface", " ", "at", " ", "each", " ", "ptot", " ", 
      "level", " ", "from", " ", "0.1", " ", "to", " ", "0.9", " ", "and", " ",
       "decode", " ", "them", " ", "into", " ", "synthetic", " ", "CDI", " ", 
      RowBox[{"profiles", "."}]}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "generateTrajectoryCDIRows", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"generateTrajectoryCDIRows", "[", 
     RowBox[{"trajectoryFunction_", ",", "seedFunction_", ",", 
      RowBox[{"numSamples_Integer", ":", "100"}]}], "]"}], ":=", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ptot", "=", 
             RowBox[{"k", "/", "10."}]}], ",", "latentSamples", ",", 
            "cdiSamples"}], "}"}], ",", 
          RowBox[{
           RowBox[{"latentSamples", "=", 
            RowBox[{"createZdata", "[", 
             RowBox[{
              RowBox[{"trajectoryFunction", "[", "ptot", "]"}], ",", "ptot", ",",
