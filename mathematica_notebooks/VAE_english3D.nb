     "\:51680\:30fb\:51681\:306e\:6f5c\:5728\:8868\:73fe\:307e\:3067\:5ef6\
\:9577\:3059\:308b", " ", "Smooth", " ", "the", " ", "five", " ", 
      "trajectories", " ", "and", " ", "extend", " ", "them", " ", "to", " ", 
      "the", " ", "latent", " ", "representations", " ", "of", " ", "the", " ",
       "all"}], "-", 
     RowBox[{"zero", " ", "and", " ", "all"}], "-", 
     RowBox[{"one", " ", "CDI", " ", "profiles"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"zAllZero", "=", 
     RowBox[{"toz", "[", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", "d"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"zAllOne", "=", 
     RowBox[{"toz", "[", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"1", ",", "d"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"trajectoryFilterWidth", "=", "10"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"smoothedTrajectories", "=", 
