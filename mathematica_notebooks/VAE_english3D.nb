      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"MeanFilter", "[", 
         RowBox[{
          RowBox[{"vec", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "k"}], "]"}], "]"}], ",", "n"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", "d"}], "}"}]}], "]"}]}], ";", 
