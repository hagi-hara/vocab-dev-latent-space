Cell[CellGroupData[{

Cell["\<\
\:7570\:306a\:308b\:7dcf\:8a9e\:5f59\:5272\:5408\:306b\:304a\:3051\:308b Out\
\[Dash]In \:8ef8\:ff08commonality\:ff09\:306e\:8a9e\:3054\:3068\:306e\:8868\
\:51fa\:78ba\:7387\:5dee
Word-wise production-probability differences along the Out\[Dash]In \
(commonality) axis at different total vocabulary proportions\
\>", "Subsubsection",
 CellChangeTimes->{
  4.002626054396105*^9},ExpressionUUID->"adfb359d-91a6-394d-a188-\
6133926c4baf"],

Cell[TextData[StyleBox["\:5404\:30ab\:30c6\:30b4\:30ea\:30fc\:306e\:7834\:7dda\
\:306f\:ff0cVoA \
\:9806\:306b\:4e26\:3093\:3060\:8a9e\:306e\:3046\:3061\:ff0cVoA \:304c\:56f3\
\:306e ptot \
\:3068\:7b49\:3057\:304f\:306a\:308b\:8a9e\:9806\:4f4d\:7f6e\:3092\:88dc\:9593\
\:3057\:3066\:793a\:3059\:ff0e\:7834\:7dda\:306e\:5de6\:5074\:306b\:306f VoA \
\:304c ptot \
\:3088\:308a\:5c0f\:3055\:3044\:8a9e\:ff0c\:53f3\:5074\:306b\:306f\:5927\:304d\
\:3044\:8a9e\:304c\:4e26\:3076\:ff0e\n\nIn each category, the dashed line \
marks the interpolated word position where VoA equals the plotted ptot. Words \
to its left have smaller VoA, and words to its right have larger VoA.",
 FontColor->RGBColor[0., 0.5019607843137255, 1.]]], "Text",
 CellChangeTimes->{
  4.0026268098403873`*^9},ExpressionUUID->"6f6a4de5-9bae-0944-94b9-\
64e01b454a40"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "\:4efb\:610f\:306e\:7dcf\:8a9e\:5f59\:5272\:5408\:3067", " ", 
     "Out\:ff0dIn", " ", "\:8ef8", 
     RowBox[{"\:ff08", "commonality", "\:ff09"}], "\:306e", " ", 
     "\:8a9e\:3054\:3068\:306e\:8868\:51fa\:78ba\:7387\:5dee\:3092\:63cf\:304f\
"}], "\:ff0e", 
    RowBox[{
     RowBox[{"Plot", " ", "word"}], "-", 
     RowBox[{"wise", " ", "Out\:ff0dIn", " ", "production"}], "-", 
     RowBox[{
     "probability", " ", "differences", " ", "at", " ", "a", " ", "specified",
       " ", "total", " ", "vocabulary", " ", 
      RowBox[{"proportion", "."}]}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "outInDifferencePlotAt", "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"outInDifferencePlotAt", "[", 
      RowBox[{"ptot_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"values", ",", "points", ",", 
         RowBox[{"yRange", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "0.8"}], ",", "0.8"}], "}"}]}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"values", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"predict", "[", 
             RowBox[{"zout3", "[", "ptot", "]"}], "]"}], "-", 
            RowBox[{"predict", "[", 
             RowBox[{"zin3", "[", "ptot", "]"}], "]"}]}], ")"}], "[", 
          RowBox[{"[", "orderbyvoa", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"points", "=", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Tooltip", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"#1", ",", "#2"}], "}"}], ",", "#3"}], "]"}], "&"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"Length", "[", "values", "]"}], "]"}], ",", "values", ",",
              "itemsvoa"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ListPlot", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"points", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ";;", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "&"}], "/@", 
            "catn"}], ")"}], ",", 
          RowBox[{"Filling", "->", "Axis"}], ",", 
          RowBox[{"Frame", "->", "True"}], ",", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Word position (categories concatenated; VoA order \
within each)\>\"", ",", "\"\<Production probability (Out - In)\>\""}], 
            "}"}]}], ",", 
          RowBox[{"ImageSize", "->", "600"}], ",", 
          RowBox[{"AspectRatio", "->", 
           RowBox[{"1", "/", "2"}]}], ",", 
          RowBox[{"PlotRange", "->", "yRange"}], ",", 
          RowBox[{"PlotLegends", "->", 
           RowBox[{"Placed", "[", 
            RowBox[{"catname", ",", "Right"}], "]"}]}], ",", 
          RowBox[{"PlotLabel", "->", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<ptot = \>\"", ",", "ptot"}], "}"}], "]"}]}], ",", 
          RowBox[{"Epilog", "->", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"Dashed", ",", "Thin", ",", 
               RowBox[{"Line", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"ptotToRank", "[", "nc", "]"}], "[", "ptot", 
                    "]"}], ",", 
                    RowBox[{"yRange", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"ptotToRank", "[", "nc", "]"}], "[", "ptot", 
                    "]"}], ",", 
                    RowBox[{"yRange", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "}"}], "]"}]}],
               "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"nc", ",", 
               RowBox[{"Length", "[", "catn", "]"}]}], "}"}]}], "]"}]}]}], 
         "]"}]}]}], "]"}]}], ";"}]}]}]], "Input",
