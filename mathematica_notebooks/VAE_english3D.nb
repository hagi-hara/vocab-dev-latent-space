Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"wordProbabilityPlot", "[", 
     RowBox[{"trajectory_", ",", "name_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"probabilities", ",", "points"}], "}"}], ",", 
      RowBox[{
