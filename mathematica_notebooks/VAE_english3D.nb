Cell[CellGroupData[{

Cell["\<\
\:7570\:306a\:308b\:7dcf\:8a9e\:5f59\:5272\:5408\:306b\:304a\:3051\:308b Left\
\[Dash]Right \:8ef8\:ff08nominality\:ff09\:306e\:8a9e\:3054\:3068\:306e\:8868\
\:51fa\:78ba\:7387\:5dee
Word-wise production-probability differences along the Left\[Dash]Right \
(nominality) axis at different total vocabulary proportions\
\>", "Subsubsection",
 CellChangeTimes->{
  4.002625629365095*^9},ExpressionUUID->"2a238bf5-17c2-b54b-b71b-\
8401418b696a"],

Cell[TextData[StyleBox["\:5404\:30ab\:30c6\:30b4\:30ea\:30fc\:306e\:7834\:7dda\
\:306f\:ff0cVoA \
\:9806\:306b\:4e26\:3093\:3060\:8a9e\:306e\:3046\:3061\:ff0cVoA \:304c\:56f3\
\:306e ptot \
\:3068\:7b49\:3057\:304f\:306a\:308b\:8a9e\:9806\:4f4d\:7f6e\:3092\:88dc\:9593\
\:3057\:3066\:793a\:3059\:ff0e\:7834\:7dda\:306e\:5de6\:5074\:306b\:306f VoA \
\:304c ptot \
\:3088\:308a\:5c0f\:3055\:3044\:8a9e\:ff0c\:53f3\:5074\:306b\:306f\:5927\:304d\
\:3044\:8a9e\:304c\:4e26\:3076\:ff0e\n\nIn each category, the dashed line \
marks the interpolated word position where VoA equals the plotted ptot . \
Words to its left have smaller VoA, and words to its right have larger VoA .",
 FontColor->RGBColor[0., 0.5019607843137255, 1.]]], "Text",
 CellChangeTimes->{{4.0026267954324913`*^9, 4.0026267954324913`*^9}, {
  4.002626836232231*^9, 
  4.0026268426247215`*^9}},ExpressionUUID->"af6acf63-64a6-314d-88e1-\
5e5c882d7101"],

