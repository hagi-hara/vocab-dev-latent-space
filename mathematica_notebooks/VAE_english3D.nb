Cell["\<\
\:7dcf\:8a9e\:5f59\:5272\:5408 ptot \
\:3067\:30d1\:30e9\:30e1\:30fc\:30bf\:5316\:3057\:305f5\:672c\:306e\:6f5c\
\:5728\:7a7a\:9593\:8ecc\:9053\:306e\:69cb\:7bc9
Construction of five latent-space trajectories parameterized by total \
vocabulary proportion ptot\
\>", "Subsubsection",
 CellChangeTimes->{{3.923965390419408*^9, 3.9239654922468023`*^9}, {
  4.0021000371728497`*^9, 
  4.0021000706123466`*^9}},ExpressionUUID->"12a3ccc2-87cd-4f6f-bcdf-\
b85306689491"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "\:5e73\:6ed1\:5316\:6e08\:307f\:306e\:8ecc\:9053\:3092\:51680\:30fb\:5168\
1\:306e\:6f5c\:5728\:8868\:73fe\:307e\:3067\:5ef6\:9577\:3059\:308b", " ", 
     "Extend", " ", "a", " ", "smoothed", " ", "trajectory", " ", "to", " ", 
     "the", " ", "latent", " ", "representations", " ", "of", " ", "the", " ",
      "all"}], "-", 
    RowBox[{"zero", " ", "and", " ", "all"}], "-", 
    RowBox[{"one", " ", "CDI", " ", "profiles"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"extendTrajectoryToEndpoints", "[", 
      RowBox[{"path_", ",", "zZero_", ",", "zOne_", ",", 
       RowBox[{"nSegments_", ":", "5"}]}], "]"}], ":=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Most", "@", 
        RowBox[{"Subdivide", "[", 
         RowBox[{"zZero", ",", 
          RowBox[{"First", "[", "path", "]"}], ",", "nSegments"}], "]"}]}], ",",
        "path", ",", 
       RowBox[{"Rest", "@", 
        RowBox[{"Subdivide", "[", 
         RowBox[{
          RowBox[{"Last", "[", "path", "]"}], ",", "zOne", ",", "nSegments"}],
          "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "\:8ecc\:9053\:3092\:7dcf\:8a9e\:5f59\:5272\:5408\:3067\:30d1\:30e9\:30e1\
\:30fc\:30bf\:5316\:3059\:308b\:305f\:3081\:306e\:60c5\:5831\:3092\:4f5c\:308b\
", " ", "Construct", " ", "the", " ", "information", " ", "required", " ", 
     "to", " ", "parameterize", " ", "a", " ", "trajectory", " ", "by", " ", 
     "total", " ", "vocabulary", " ", "proportion"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"makeVocabularyTrajectory", "[", "points_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "vocabProportion", ",", "coordinateFunctions", ",", 
         "vocabProportionToIndex"}], "}"}], ",", 
       RowBox[{
        RowBox[{"vocabProportion", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Mean", "[", 
            RowBox[{"predict", "[", "#", "]"}], "]"}], "&"}], "/@", 
          "points"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"coordinateFunctions", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Interpolation", "[", 
            RowBox[{
             RowBox[{"points", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "k"}], "]"}], "]"}], ",", 
             RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "1", ",", "3"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"vocabProportionToIndex", "=", 
         RowBox[{"Interpolation", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{"vocabProportion", ",", 
              RowBox[{"Range", "[", 
               RowBox[{"Length", "[", "points", "]"}], "]"}]}], "}"}], "]"}], 
           ",", 
           RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Points\>\"", "->", "points"}], ",", 
          RowBox[{"\"\<VocabularyProportion\>\"", "->", "vocabProportion"}], ",", 
          
          RowBox[{"\"\<CoordinateFunctions\>\"", "->", 
           "coordinateFunctions"}], ",", 
          
          RowBox[{"\"\<VocabularyProportionToIndex\>\"", "->", 
           "vocabProportionToIndex"}]}], "|>"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "\:6307\:5b9a\:3055\:308c\:305f\:7dcf\:8a9e\:5f59\:5272\:5408\:306b\:5bfe\
\:5fdc\:3059\:308b\:6f5c\:5728\:5ea7\:6a19\:3092\:8fd4\:3059", " ", "Return", 
     " ", "the", " ", "latent", " ", "coordinate", " ", "corresponding", " ", 
     "to", " ", "the", " ", "specified", " ", "total", " ", "vocabulary", " ",
      "proportion"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"trajectoryPoint", "[", 
      RowBox[{"trajectory_Association", ",", "ptot_"}], "]"}], ":=", 
     RowBox[{"Through", "[", 
      RowBox[{
       RowBox[{"trajectory", "[", "\"\<CoordinateFunctions\>\"", "]"}], "[", 
       RowBox[{
        RowBox[{
        "trajectory", "[", "\"\<VocabularyProportionToIndex\>\"", "]"}], "[", 
        "ptot", "]"}], "]"}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.0020729766108494`*^9, 4.0020729899878654`*^9}, {
