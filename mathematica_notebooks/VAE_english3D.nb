   RowBox[{
    RowBox[{"debRoyProfiles", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"NumericQ", "[", "#", "]"}], "&&", 
            RowBox[{"#", "<=", "ageM"}]}], ",", "1", ",", "0"}], "]"}], "&"}],
         "/@", "debRoyAoAM"}], ",", 
       RowBox[{"{", 
        RowBox[{"ageM", ",", "debRoyAgeM"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Projection", " ", "into", " ", "the", " ", "three"}], "-", 
     RowBox[{"dimensional", " ", "latent", " ", "space"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"debRoyMonth", "=", 
     RowBox[{"toz", "/@", "debRoyProfiles"}]}], ";"}]}]}]], "Input",
