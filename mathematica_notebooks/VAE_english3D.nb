Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"cmp05", "=", 
  RowBox[{"ContourPlot3D", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"mpfunc", "[", 
      RowBox[{"x", ",", "y", ",", "z"}], "]"}], "==", "0.5"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", 
      RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", 
      RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
    RowBox[{"ContourStyle", "\[Rule]", 
     RowBox[{"Opacity", "[", "0.5", "]"}]}], ",", 
    RowBox[{"AxesLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"\"\<z1\>\"", ",", "16"}], "]"}], ",", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<z2\>\"", ",", "16"}], "]"}], ",", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<z3\>\"", ",", "16"}], "]"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
