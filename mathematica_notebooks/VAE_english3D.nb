Cell[BoxData[
 RowBox[{
  RowBox[{"movedPt", "[", 
   RowBox[{"startpt_", ",", "ptot_"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "vec", ",", "x", ",", "y", ",", "z", ",", "init", ",", "normalv", ",", 
      "vec1", ",", "ptot1", ",", "ans", ",", "ansvec"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"vec", "=", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"init", "=", 
      RowBox[{"Rule", "@@@", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"vec", ",", "startpt"}], "}"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"normalv", "=", 
      RowBox[{"Normalize", "[", 
       RowBox[{
        RowBox[{"Grad", "[", 
         RowBox[{
          RowBox[{"fall", "[", 
           RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], "/.", "init"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vec1", "[", "t_", "]"}], ":=", " ", 
      RowBox[{"startpt", " ", "+", " ", 
       RowBox[{"normalv", " ", "t"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ptot1", "[", "t_", "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"fall", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], "]"}], "&"}], "/@", 
         RowBox[{"{", 
          RowBox[{"vec1", "[", "t", "]"}], "}"}]}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "    ", 
     RowBox[{"ans", "=", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ptot1", "[", "t", "]"}], "==", "ptot"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0."}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ansvec", " ", "=", " ", 
      RowBox[{
       RowBox[{"vec1", "[", "t", "]"}], "/.", "ans"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.919002260477843*^9, 3.9190022829877667`*^9}, {
  3.9190065147437687`*^9, 3.9190065221991787`*^9}, {3.919006557479842*^9, 
