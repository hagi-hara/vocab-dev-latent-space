Cell[BoxData[
 RowBox[{
  RowBox[{"mpfunc", "=", 
   RowBox[{"Interpolation", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"mpdata", ",", "2"}], "]"}], "]"}]}], ";"}]], "Input",
